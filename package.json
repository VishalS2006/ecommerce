{
  "name": "shopsphere-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "ShopSphere - Full-Stack E-Commerce Platform",
  "scripts": {
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client dev",
    "seed": "npm --prefix server run seed",
    "install:all": "npm --prefix server install && npm --prefix client install",
    "dev": "concurrently \"npm --prefix server run dev\" \"npm --prefix client dev\""
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
